# File cấu hình RIÊNG của máy này — đã nằm trong .gitignore nên không commit được.
#
# VIỆC DUY NHẤT BẠN CẦN LÀM: dán key MỚI vào dòng GEMINI_API_KEY bên dưới.
# Key cũ đã dán trong chat được coi là lộ — vào https://aistudio.google.com/apikey
# thu hồi nó rồi tạo key khác. Để trống thì app vẫn chạy bình thường, chỉ có
# khung "Hỏi AI" báo "chưa có key" (xem dòng trạng thái trong khung chat).
# Dán key XONG KHÔNG CẦN BẬT LẠI MÁY CHỦ: bấm Gửi trong khung chat là proxy tự
# đọc lại file này (chỉ khi nào sửa một key đã nạp sẵn thì mới phải bật lại).
GEMINI_API_KEY=AQ.Ab8RN6JDVlvhA2iMFKkp9O4R26y0y2Ax3mCilbnLtknogEImPg

# Tên mô hình. Mặc định đã đúng theo yêu cầu, đổi ở đây mà không sửa code.
# Đo lại ngày 28-29/10/2026 (cùng một câu hỏi, nhiều lượt, tính tới MẢNH CHỮ ĐẦU
# TIÊN): gemini-flash-lite-latest có lượt chỉ 2,2 s nhưng phổ biến là 12-26 s;
# gemini-3.1-flash-lite thì Google báo 503 "high demand" hết lần này tới lần khác,
# một lượt may mắn ra chữ sau 71,9 s. Vì thế mặc định mới là bản Lite ổn định hơn.
# Đổi model xong phải BẬT LẠI máy chủ (hoặc tắt/mở lại cửa sổ chay-ai.bat).
GEMINI_MODEL=gemini-flash-lite-latest

# Mô hình dự phòng khi model chính bị Google báo 503 "high demand" vài phút liền.
# Đo 28-29/10: gemini-3.5-flash-lite ra chữ sau 16,2-27,0 s — chậm hơn một chút
# nhưng là đường thứ hai thật sự có trả lời. Xoá hẳn dòng = dùng mặc định trong
# code; để trống = tắt dự phòng.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Mô hình cho chế độ "Kỹ" trong khung chat (người dùng chủ động chọn trả lời sâu
# hơn và chấp nhận chờ lâu hơn). Để trống = dùng GEMINI_FALLBACK_MODEL.
# GEMINI_DEEP_MODEL=gemini-3.5-flash-lite

# Máy chủ proxy chỉ mở ở chính máy này (loopback). Đổi cổng thì phải đổi luôn
# chỗ gọi trong giao diện.
GEMINI_PROXY_HOST=127.0.0.1
GEMINI_PROXY_PORT=8000

# CYSIM_ORIGINS = danh sách "trang nào được phép gọi vào proxy này" (CORS). Đây
# KHÔNG phải khoá bảo mật và không liên quan gì tới API key: key nằm ở
# GEMINI_API_KEY phía trên, còn dòng này chỉ so khớp cái header `Origin` mà
# trình duyệt gửi kèm mỗi request để proxy quyết định có trả lời hay không.
# ĐỂ TRỐNG LÀ ĐÚNG khi app chạy trên chính máy này — proxy tự chấp nhận mọi
# origin có host là 127.0.0.1 / localhost / [::1] ở bất kỳ cổng nào, nên Live
# Server 5505, cổng 8137 hay 3000 đều gọi được ngay, không cần điền gì cả.
# Chỉ cần điền khi một MÁY KHÁC (điện thoại, máy bạn) mở app trỏ về máy này:
#   CYSIM_ORIGINS=http://192.168.1.42:5500,http://may-cua-ban:8080
# Lúc đó còn phải đổi GEMINI_PROXY_HOST thành 0.0.0.0, tức là cho cả mạng nội bộ
# vào được máy bạn — chỉ làm khi thật sự cần.
CYSIM_ORIGINS=

# Hai núm vặn tốc độ/độ dài (mặc định đã đặt trong code). ĐỂ TRỐNG `KEY=` là lỗi
# Vì code gọi int() nên chỉ nhận một con số. Muốn giữ mặc định thì xoá hẳn dòng.
# GEMINI_MAX_TOKENS=2048      # trần 1024 từng cắt câu tiếng Việt giữa chừng
# GEMINI_THINKING_BUDGET=     # để trống là đúng; dòng Lite từ chối giá trị 0
